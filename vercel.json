{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm install && npx prisma generate",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/shield-pdf/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/guardian-ai/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/ghl/rescue-lead/route.ts": {
      "maxDuration": 15
    },
    "src/app/api/contact/route.ts": {
      "maxDuration": 15
    }
  }
}
